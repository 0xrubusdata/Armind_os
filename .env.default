#DATABASE ORM
POSTGRES_USER=trading_agent
POSTGRES_PASSWORD=password
POSTGRES_DB=trading_data
POSTGRES_PORT=5432

#AI MODEL
OLLAMA_LOCAL_MODEL_NAME=deepseek-r1:7b

# Load Time Options - Model
OLLAMA_LOCAL_MODEL_NUM_CTX=None # Optional[int] = None - Determines the size of the context (number of tokens) the model will use.
OLLAMA_LOCAL_MODEL_F16_KV=False # Optional[bool] = None - Enables 16-bit precision for key/value matrices in the attention mechanism to reduce memory usage.
OLLAMA_LOCAL_MODEL_LOGITS_ALL=False # Optional[bool] = None - Configures the model to output all logits (raw scores) for debugging or detailed analysis.
OLLAMA_LOCAL_MODEL_VOCAB_ONLY=False # Optional[bool] = None - Loads only the vocabulary without the full model weights.
OLLAMA_LOCAL_MODEL_EMBEDDING_ONLY=False # Optional[bool] = None - Loads only the model embeddings, useful for feature extraction tasks.
# Runtime Options - Model
OLLAMA_LOCAL_MODEL_NUM_KEEP=None # Optional[int] = None - Specifies the number of tokens from the context to retain during generation.
OLLAMA_LOCAL_MODEL_SEED=None # Optional[int] = None - Sets the random seed for reproducible output.
OLLAMA_LOCAL_MODEL_NUM_PREDICT=None # Optional[int] = None - Determines the number of tokens the model should generate.
OLLAMA_LOCAL_MODEL_TOP_K=None # Optional[int] = None - Limits token sampling to the top K most probable tokens at each step.
OLLAMA_LOCAL_MODEL_TOP_P=None # Optional[float] = None - Uses nucleus sampling, considering tokens within the top cumulative probability p.
OLLAMA_LOCAL_MODEL_TFS_Z=None # Optional[float] = None - Tail Free Sampling parameter that filters out low-probability tokens.
OLLAMA_LOCAL_MODEL_TYPICAL_P=None # Optional[float] = None - Controls token selection based on typicality, favoring tokens representative of the overall distribution.
OLLAMA_LOCAL_MODEL_REPEAT_LAST_N=None # Optional[int] = None - Defines how many previous tokens to consider when applying repetition penalties.
OLLAMA_LOCAL_MODEL_TEMPERATURE=0 # Optional[float] = None - Adjusts randomness during generation; higher values yield more diverse outputs.
OLLAMA_LOCAL_MODEL_REPEAT_PENALTY=None # Optional[float] = None - Applies a penalty to repeated tokens to reduce redundancy.
OLLAMA_LOCAL_MODEL_PRESENCE_PENALTY=None # Optional[float] = None - Penalizes tokens that have already appeared to encourage new content.
OLLAMA_LOCAL_MODEL_FREQUENCY_PENALTY=None # Optional[float] = None - Discourages the model from overusing common tokens.
OLLAMA_LOCAL_MODEL_MIROSTAT=None # Optional[int] = None - Activates the Mirostat algorithm for adaptive control over sampling.
OLLAMA_LOCAL_MODEL_MIROSTAT_TAU=None # Optional[float] = None - Parameter tau for fine-tuning the behavior of the Mirostat algorithm.
OLLAMA_LOCAL_MODEL_MIROSTAT_ETA=None # Optional[float] = None - Parameter eta for adjusting the Mirostat sampling dynamics.
OLLAMA_LOCAL_MODEL_PENALIZE_NEWLINE=False # Optional[bool] = None - Applies a penalty to newline tokens to control output formatting.
OLLAMA_LOCAL_MODEL_STOP=None # Optional[Sequence[str]] = None - Defines stop sequences that, when encountered, immediately terminate text generation.

#PORTS
PORTAINER_PORT=9000 # Portainer
CLIENT_PORT=3001    # Next frontend
AGENT_PORT=3000     # Nest backend
TOOL_PORT=5300      # FastApi
LSTM_PORT=5200      # FastApi 
OLLAMA_PORT=5100    # FastApi 
FAISS_PORT=5000     # FastApi
ADMINER_PORT=8080   # Adminer